<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f4f6f6">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- Device Selector Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Selected PowerTap"
                app:startIconDrawable="@android:drawable/ic_dialog_info"
                app:startIconTint="@color/primary_blue"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <AutoCompleteTextView
                    android:id="@+id/deviceSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- LCD View (Below) -->
            <com.drivool.iot.powertap.TwoLineLCDView
                android:id="@+id/lcd_view"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp" />

            <!-- Tabbed Content Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tabIndicatorColor="@color/tab_indicator"
                        app:tabSelectedTextColor="@color/tab_indicator"
                        app:tabTextColor="#757575"
                        app:tabRippleColor="@android:color/transparent"
                        app:tabMode="fixed"
                        app:tabGravity="fill"
                        android:background="@color/white">
                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FULL CHARGE" />
                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SET TIME" />
                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SET UNITS" />
                    </com.google.android.material.tabs.TabLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txtIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔋"
                            android:textSize="48sp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:id="@+id/txtTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FULL CHARGE"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Charge to 100% capacity"
                            android:textColor="#888888"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/sliderSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:gravity="center">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnMinus"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:text="-"
                                    android:textAllCaps="false"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="28sp"
                                    app:backgroundTint="#C8B0F9"
                                    app:cornerRadius="28dp"
                                    android:padding="0dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:insetLeft="0dp"
                                    android:insetRight="0dp"
                                    app:iconPadding="0dp" />

                                <TextView
                                    android:id="@+id/txtValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="1:00"
                                    android:textSize="32sp"
                                    android:textColor="@color/black"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPlus"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:text="+"
                                    android:textAllCaps="false"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="20sp"
                                    app:backgroundTint="#C8B0F9"
                                    app:cornerRadius="28dp"
                                    android:padding="0dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:insetLeft="0dp"
                                    android:insetRight="0dp"
                                    app:iconPadding="0dp" />
                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekBar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp" />

                            <TextView
                                android:id="@+id/txtInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textColor="#888888"
                                android:textSize="14sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.drivool.iot.powertap.SliderButtonView
                android:id="@+id/slider_button"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#f4f6f6"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👋"
                android:textSize="80sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ready to Charge?"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Connect your first PowerTap device to get started."
                android:textColor="#666666"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupFirstDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:padding="16dp"
                android:text="Find Nearby Devices"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </FrameLayout>
</ScrollView>